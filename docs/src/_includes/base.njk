<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {%- set pageTitle = (title + " · " + site.title) if (title and title != "Home") else (site.title + " · " + site.tagline) %}
    {%- set pageDesc = description or site.tagline %}
    {%- set canonical = site.url + page.url %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDesc }}" />
    <link rel="canonical" href="{{ canonical }}" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDesc }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ site.url }}/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDesc }}" />
    <meta name="twitter:image" content="{{ site.url }}/og.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}" />
    <link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | url }}" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/favicon.png' | url }}" />
    <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}" />
    <script>
      // Apply saved theme before paint to avoid a flash. Dark is the default.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <header class="topbar">
      <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">☰</label>
      <a class="brand" href="{{ '/' | url }}">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <g fill="currentColor">
            <rect x="6" y="13" width="3.5" height="6" rx="1.75" />
            <rect x="11.5" y="9" width="3.5" height="14" rx="1.75" />
            <rect x="17" y="5" width="3.5" height="22" rx="1.75" />
            <rect x="22.5" y="11" width="3.5" height="10" rx="1.75" />
          </g>
        </svg>
        <span class="brand-text"><span class="at">@arnabxd/</span>ntgcalls-napi</span>
      </a>
      <span class="topbar-spacer"></span>
      <span class="topbar-meta">v{{ lib.version }}</span>
      <a class="topbar-link" href="{{ site.npm }}" target="_blank" rel="noopener">npm</a>
      <a class="topbar-link" href="{{ site.repo }}" target="_blank" rel="noopener">GitHub</a>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">◐</button>
    </header>

    <div class="layout">
      <aside class="sidebar">
        <nav>
          {%- set groups = ["Guide", "Reference"] %}
          {%- for grp in groups %}
          <div class="nav-group">
            <p class="nav-group-label">{{ grp }}</p>
            {%- if grp == "Guide" %}
            <a class="nav-link {% if page.url == ('/' | url) %}active{% endif %}" href="{{ '/' | url }}">
              <span class="idx">00</span> Home
            </a>
            {%- endif %}
            {%- for item in collections.docs %}
            {%- if item.data.group == grp %}
            <a class="nav-link {% if page.url == item.url %}active{% endif %}" href="{{ item.url | url }}">
              <span class="idx">{{ item.data.order | pad2 }}</span> {{ item.data.title }}
            </a>
            {%- endif %}
            {%- endfor %}
          </div>
          {%- endfor %}

          <div class="nav-group sidebar-links">
            <p class="nav-group-label">Links</p>
            <a class="nav-link" href="{{ site.npm }}" target="_blank" rel="noopener">npm</a>
            <a class="nav-link" href="{{ site.repo }}" target="_blank" rel="noopener">GitHub</a>
          </div>
        </nav>
      </aside>

      <main class="content">
        <article>
          {%- if eyebrow and title != "Home" %}
          <div class="eyebrow">
            <span class="seg">{{ order | pad2 }}</span> {{ eyebrow }}
            <span class="bar"></span>
          </div>
          {%- endif %}
          {{ content | safe }}
          <div class="page-meta">
            <a href="{{ site.repo }}" target="_blank" rel="noopener">Edit on GitHub</a>
            <span>·</span>
            <span>MIT</span>
            <span>·</span>
            <span>v{{ lib.version }}</span>
          </div>
        </article>
      </main>

      {%- set headings = content | toc %}
      {%- if headings.length and title != "Home" %}
      <aside class="toc">
        <p class="toc-label">On this page</p>
        <nav>
          {%- for h in headings %}
          <a class="{% if h.level == 3 %}h3{% endif %}" href="#{{ h.id }}">{{ h.text }}</a>
          {%- endfor %}
        </nav>
      </aside>
      {%- endif %}
    </div>

    <label for="nav-toggle" class="nav-backdrop" aria-hidden="true"></label>

    <footer class="site-footer">
      <p class="site-footer-credit">
        Developed by
        <a href="{{ site.author.url }}" target="_blank" rel="noopener">{{ site.author.name }}</a>
        · Backed by
        <a href="{{ site.sponsor.url }}" target="_blank" rel="noopener">{{ site.sponsor.name }}</a>
      </p>
    </footer>

    <script src="{{ '/assets/theme.js' | url }}"></script>
    <script src="{{ '/assets/tabs.js' | url }}"></script>
  </body>
</html>
