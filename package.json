{
  "name": "@arnabxd/ntgcalls-napi",
  "version": "0.3.1",
  "description": "Thread-safe Rust N-API native bindings for libntgcalls",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "prepare": "lefthook install",
    "postinstall": "node postinstall.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "cargo fmt",
    "build": "napi build --release --dts binding.d.ts",
    "changelog": "npx git-cliff -o CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArnabXD/ntgcalls-napi"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.d.ts",
    "postinstall.js"
  ],
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@napi-rs/cli": "^3.7.0",
    "lefthook": "latest"
  }
}
