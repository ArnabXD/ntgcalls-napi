{
  "name": "@arnabxd/ntgcalls-napi",
  "version": "0.3.0-beta-01",
  "description": "Thread-safe Rust N-API native bindings for libntgcalls",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "prepare": "lefthook install",
    "postinstall": "node postinstall.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "cargo fmt",
    "build": "cargo build --release && node -e \"const{cpSync}=require('fs'),p=process.platform;cpSync(p==='win32'?'target/release/ntgcalls.dll':p==='darwin'?'target/release/libntgcalls.dylib':'target/release/libntgcalls.so','ntgcalls.node')\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArnabXD/ntgcalls-napi"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "postinstall.js"
  ],
  "devDependencies": {
    "@biomejs/biome": "latest",
    "lefthook": "latest"
  }
}
